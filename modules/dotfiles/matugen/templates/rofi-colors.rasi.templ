* {
    bg-col:        #{{colors.surface.default.hex_stripped}};
    bg-col-light:  #{{colors.surface.default.hex_stripped}};
    border-col:    #{{colors.surface.default.hex_stripped}};
    selected-col:  #{{colors.surface.default.hex_stripped}};
    blue:          #{{colors.primary.default.hex_stripped}};
    fg-col:        #{{colors.on_surface.default.hex_stripped}};
    fg-col2:       #{{colors.primary.default.hex_stripped}};
    grey:          #{{colors.secondary.default.hex_stripped}};
    teal:          #{{colors.primary.default.hex_stripped}};
    width: 600;
    border-radius: 15px;
}
