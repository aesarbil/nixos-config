{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 380,
  "control-center-height": 860,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 0,
  "notification-body-image-width": 0,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 100,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "backlight",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No molestar",
      "do-not-disturb-on-startup": false,
      "do-not-disturb": false
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 19,
      "show-album-art": "playing",
      "blacklist": [
        "firefox",
        "librewolf",
        "chromium",
        "brave",
        "mpv",
        "playerctl"
      ],
      "autohide": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 10
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖁",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰍬",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰤨",
          "command": "sh -c 'if [ \"$(nmcli radio wifi)\" = \"enabled\" ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'",
          "type": "toggle",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = \"enabled\" ] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "command": "rfkill toggle bluetooth",
          "type": "toggle",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: no\" && echo true || echo false'"
        },
        {
          "label": "󰏘",
          "command": "hyprpicker -a"
        },
        {
          "label": "󰋩",
          "command": "swaync-client -t -sw; waypaper"
        },
        {
          "label": "󰄀",
          "command": "grim -g \"$(slurp)\" - | wl-copy && notify-send '📋 Captura copiada'"
        },
        {
          "label": "󰐥",
          "command": "wleave"
        }
      ]
    }
  }
}
